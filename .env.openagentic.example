# Default web/CLI provider profile. Copy to .env.openagentic and protect with chmod 600.
OPENAI_COMPATIBLE_API_KEY=replace-with-openagentic-key
TRADINGAGENTS_LLM_PROVIDER=openai_compatible
TRADINGAGENTS_LLM_BACKEND_URL=https://openagentic.id/api/v1
TRADINGAGENTS_QUICK_THINK_LLM=deepseek-v4.1-flash
TRADINGAGENTS_DEEP_THINK_LLM=deepseek-v4.1-flash
TRADINGAGENTS_LLM_MAX_RETRIES=15
TRADINGAGENTS_CHECKPOINT_ENABLED=true
TRADINGAGENTS_RESULTS_DIR=./results
