TRADINGAGENTS_LLM_PROVIDER=glm
TRADINGAGENTS_LLM_BACKEND_URL=https://api.z.ai/api/paas/v4/
TRADINGAGENTS_QUICK_THINK_LLM=glm-5.3
TRADINGAGENTS_DEEP_THINK_LLM=glm-5.3
TRADINGAGENTS_LLM_MAX_RETRIES=15
TRADINGAGENTS_CHECKPOINT_ENABLED=true
TRADINGAGENTS_RESULTS_DIR=./results
